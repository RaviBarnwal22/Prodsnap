{
    "framework": "nextjs",
    "buildCommand": "npm run build",
    "devCommand": "npm run dev",
    "installCommand": "npm install",
    "outputDirectory": ".next",
    "crons": [
        {
            "path": "/api/cron/refresh-news",
            "schedule": "30 23 * * *"
        },
        {
            "path": "/api/cron/viral-post",
            "schedule": "30 3 * * *"
        },
        {
            "path": "/api/cron/refresh-jobs",
            "schedule": "0 1 * * *"
        }
    ]
}
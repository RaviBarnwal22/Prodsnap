generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  authId           String?              @unique
  name             String?
  image            String?
  role             String               @default("STUDENT")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  firstName        String?
  lastName         String?
  bookings         Booking[]
  mentorSessions   Booking[]            @relation("MentorBookings")
  categoryAttempts CategoryAttempt[]
  expertProfile    ExpertProfile?
  practiceFeedback PracticeFeedback[]
  submissions      PracticeSubmission[]
  puzzleAttempts   PuzzleAttempt[]
  reviews          Review[]
  subscription     Subscription?
  activities       UserActivity[]
  streak           UserStreak?
}

model ExpertProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  company         String
  role            String
  experienceYears Int
  linkedInUrl     String?
  isVerified      Boolean   @default(false)
  hourlyRateINR   Int
  skills          String
  user            User      @relation(fields: [userId], references: [id])
  services        Service[]
}

model PracticeQuestion {
  id           String               @id @default(cuid())
  title        String
  description  String
  category     String
  difficulty   String
  solutionText String?
  sampleAnswer String?
  isFree       Boolean              @default(false)
  createdAt    DateTime             @default(now())
  submissions  PracticeSubmission[]
}

model PracticeSubmission {
  id             String           @id @default(cuid())
  userId         String
  questionId     String
  answerText     String
  aiScore        String?
  timeSpent      Int?
  isGoldStandard Boolean          @default(false)
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id])
  question       PracticeQuestion @relation(fields: [questionId], references: [id])
  reviews        Review[]
}

model Review {
  id           String             @id @default(cuid())
  submissionId String
  reviewerId   String?
  type         String
  content      String
  score        Int
  details      String?
  createdAt    DateTime           @default(now())
  aiAccuracy   Int?
  submission   PracticeSubmission @relation(fields: [submissionId], references: [id])
  reviewer     User?              @relation(fields: [reviewerId], references: [id])
}

model Service {
  id          String        @id @default(cuid())
  expertId    String
  type        String
  title       String
  durationMin Int
  priceINR    Int
  expert      ExpertProfile @relation(fields: [expertId], references: [id])
}

model Booking {
  id          String   @id @default(cuid())
  menteeId    String
  mentorId    String
  serviceId   String
  status      String   @default("PENDING")
  scheduledAt DateTime
  meetingUrl  String?
  createdAt   DateTime @default(now())
  mentee      User     @relation(fields: [menteeId], references: [id])
  mentor      User     @relation("MentorBookings", fields: [mentorId], references: [id])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String?
  page      String
  action    String
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model ContactSubmission {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model DailyPuzzle {
  id            String          @id @default(cuid())
  question      String
  context       String?
  optionA       String
  optionB       String
  optionC       String
  optionD       String?
  correctAnswer String
  explanation   String
  category      String
  difficulty    String          @default("Medium")
  publishDate   DateTime
  createdAt     DateTime        @default(now())
  attempts      PuzzleAttempt[]
}

model PuzzleAttempt {
  id        String      @id @default(cuid())
  userId    String
  puzzleId  String
  answer    String
  isCorrect Boolean
  timeTaken Int?
  createdAt DateTime    @default(now())
  puzzle    DailyPuzzle @relation(fields: [puzzleId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
}

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastPlayedAt  DateTime?
  totalCorrect  Int       @default(0)
  totalPlayed   Int       @default(0)
  user          User      @relation(fields: [userId], references: [id])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  status                 String    @default("inactive")
  planType               String    @default("monthly")
  priceINR               Int       @default(199)
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String?
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id])
}

model CategoryAttempt {
  id        String   @id @default(cuid())
  userId    String
  category  String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model SubscriptionRequest {
  id           String    @id @default(cuid())
  userId       String
  name         String
  email        String
  phone        String
  paymentProof String
  amount       Int       @default(199)
  status       String    @default("pending")
  adminNotes   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model MentorshipBooking {
  id           String              @id @default(cuid())
  userId       String?
  name         String
  email        String
  phone        String
  serviceType  String
  paymentProof String
  amount       Int
  status       String              @default("pending")
  adminNotes   String?
  scheduledAt  DateTime?
  meetingLink  String?
  completedAt  DateTime?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  feedback     MentorshipFeedback?
  emailLogs    EmailLog[]
}

model MentorshipFeedback {
  id             String            @id @default(cuid())
  bookingId      String            @unique
  name           String
  email          String
  rating         Int
  feedback       String
  wouldRecommend Boolean           @default(true)
  createdAt      DateTime          @default(now())
  booking        MentorshipBooking @relation(fields: [bookingId], references: [id])
}

model PracticeFeedback {
  id           String   @id @default(cuid())
  userId       String
  submissionId String?
  experience   String
  comments     String?
  npsScore     Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model ApiUsageLog {
  id           String   @id @default(cuid())
  provider     String   // "gemini" or "perplexity"
  model        String   // e.g., "gemini-pro", "sonar"
  status       String   // "success", "error", "rate_limit"
  responseTime Int?     // in milliseconds
  errorMessage String?
  tokenCount   Int?     // estimated tokens used
  createdAt    DateTime @default(now())
  
  @@index([createdAt])
  @@index([provider])
}

model EmailLog {
  id          String   @id @default(cuid())
  type        String   // "payment", "approval", "mentorship", "contact", "reply"
  recipient   String
  subject     String
  status      String   // "success", "error"
  errorMessage String?
  bookingId   String?  // Optional, if related to a mentorship booking
  createdAt   DateTime @default(now())

  booking     MentorshipBooking? @relation(fields: [bookingId], references: [id])
  
  @@index([createdAt])
  @@index([type])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  authId           String?              @unique
  name             String?
  image            String?
  role             String               @default("STUDENT")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  firstName        String?
  lastName         String?
  lastLoginAt      DateTime?
  bookings         Booking[]
  mentorSessions   Booking[]            @relation("MentorBookings")
  categoryAttempts CategoryAttempt[]
  expertProfile    ExpertProfile?
  practiceFeedback PracticeFeedback[]
  submissions      PracticeSubmission[]
  puzzleAttempts   PuzzleAttempt[]
  reviews          Review[]
  subscription     Subscription?
  activities       UserActivity[]
  streak           UserStreak?
}

model ExpertProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  company         String
  role            String
  experienceYears Int
  linkedInUrl     String?
  isVerified      Boolean   @default(false)
  hourlyRateINR   Int
  skills          String
  user            User      @relation(fields: [userId], references: [id])
  services        Service[]
}

model PracticeQuestion {
  id           String               @id @default(cuid())
  title        String
  description  String
  category     String
  difficulty   String
  solutionText String?
  sampleAnswer String?
  createdAt    DateTime             @default(now())
  isFree       Boolean              @default(false)
  submissions  PracticeSubmission[]
}

model PracticeSubmission {
  id             String             @id @default(cuid())
  userId         String
  questionId     String
  answerText     String
  aiScore        String?
  timeSpent      Int?
  isGoldStandard Boolean            @default(false)
  createdAt      DateTime           @default(now())
  feedbacks      PracticeFeedback[]
  question       PracticeQuestion   @relation(fields: [questionId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  reviews        Review[]
}

model Review {
  id           String             @id @default(cuid())
  submissionId String
  reviewerId   String?
  type         String
  content      String
  score        Int
  details      String?
  createdAt    DateTime           @default(now())
  aiAccuracy   Int?
  reviewer     User?              @relation(fields: [reviewerId], references: [id])
  submission   PracticeSubmission @relation(fields: [submissionId], references: [id])
}

model Service {
  id          String        @id @default(cuid())
  expertId    String
  type        String
  title       String
  durationMin Int
  priceINR    Int
  expert      ExpertProfile @relation(fields: [expertId], references: [id])
}

model Booking {
  id          String   @id @default(cuid())
  menteeId    String
  mentorId    String
  serviceId   String
  status      String   @default("PENDING")
  scheduledAt DateTime
  meetingUrl  String?
  createdAt   DateTime @default(now())
  mentee      User     @relation(fields: [menteeId], references: [id])
  mentor      User     @relation("MentorBookings", fields: [mentorId], references: [id])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String?
  page      String
  action    String
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model ContactSubmission {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model DailyPuzzle {
  id            String          @id @default(cuid())
  question      String
  context       String?
  optionA       String
  optionB       String
  optionC       String
  optionD       String?
  correctAnswer String
  explanation   String
  category      String
  difficulty    String          @default("Medium")
  publishDate   DateTime
  createdAt     DateTime        @default(now())
  attempts      PuzzleAttempt[]
}

model PuzzleAttempt {
  id        String      @id @default(cuid())
  userId    String
  puzzleId  String
  answer    String
  isCorrect Boolean
  timeTaken Int?
  createdAt DateTime    @default(now())
  puzzle    DailyPuzzle @relation(fields: [puzzleId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
}

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastPlayedAt  DateTime?
  totalCorrect  Int       @default(0)
  totalPlayed   Int       @default(0)
  user          User      @relation(fields: [userId], references: [id])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  status                 String    @default("inactive")
  planType               String    @default("monthly")
  priceINR               Int       @default(199)
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String?
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id])
}

model CategoryAttempt {
  id        String   @id @default(cuid())
  userId    String
  category  String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model SubscriptionRequest {
  id           String    @id @default(cuid())
  userId       String
  name         String
  email        String
  phone        String
  paymentProof String
  amount       Int       @default(199)
  status       String    @default("pending")
  adminNotes   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model MentorshipBooking {
  id              String              @id @default(cuid())
  userId          String?
  name            String
  email           String
  phone           String
  serviceType     String
  paymentProof    String
  amount          Int
  status          String              @default("pending")
  adminNotes      String?
  scheduledAt     DateTime?
  meetingLink     String?
  completedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  linkedinProfile String?
  messageToMentor String?
  emailLogs       EmailLog[]
  feedback        MentorshipFeedback?
}

model MentorshipFeedback {
  id             String            @id @default(cuid())
  bookingId      String            @unique
  name           String
  email          String
  rating         Int
  feedback       String
  wouldRecommend Boolean           @default(true)
  createdAt      DateTime          @default(now())
  booking        MentorshipBooking @relation(fields: [bookingId], references: [id])
}

model PracticeFeedback {
  id           String              @id @default(cuid())
  userId       String
  submissionId String?
  experience   String
  comments     String?
  npsScore     Int
  createdAt    DateTime            @default(now())
  submission   PracticeSubmission? @relation(fields: [submissionId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
}

model ApiUsageLog {
  id           String   @id @default(cuid())
  provider     String
  model        String
  status       String
  responseTime Int?
  errorMessage String?
  tokenCount   Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
}

model EmailLog {
  id           String             @id @default(cuid())
  type         String
  recipient    String
  subject      String
  status       String
  errorMessage String?
  bookingId    String?
  createdAt    DateTime           @default(now())
  booking      MentorshipBooking? @relation(fields: [bookingId], references: [id])

  @@index([createdAt])
  @@index([type])
}

model Article {
  id               String      @id @default(cuid())
  articleType      String      @default("DAILY") // DAILY, WEEKLY_TOP, MONTHLY_TOP
  category         String
  title            String
  source           String
  url              String
  date             String      // Display date string
  targetDate       DateTime    @default(now()) // For indexing/filtering
  periodIdentifier String?     // e.g., "2026-06-01" for days, "2026-W05" for weeks, "2026-M02" for months
  iconName         String
  summary          String      @db.Text
  pmPerspective    String      @db.Text
  tags             String[]
  publishedAt      DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([publishedAt])
  @@index([articleType, targetDate])
  @@index([periodIdentifier])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

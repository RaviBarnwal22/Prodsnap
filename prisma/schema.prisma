generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ApiUsageLog {
  id           String   @id
  provider     String
  model        String
  status       String
  responseTime Int?
  errorMessage String?
  tokenCount   Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
}

model Booking {
  id                          String   @id
  menteeId                    String
  mentorId                    String
  serviceId                   String
  status                      String   @default("PENDING")
  scheduledAt                 DateTime
  meetingUrl                  String?
  createdAt                   DateTime @default(now())
  User_Booking_menteeIdToUser User     @relation("Booking_menteeIdToUser", fields: [menteeId], references: [id])
  User_Booking_mentorIdToUser User     @relation("Booking_mentorIdToUser", fields: [mentorId], references: [id])
}

model CategoryAttempt {
  id        String   @id
  userId    String
  category  String
  count     Int      @default(0)
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model ContactSubmission {
  id        String    @id
  name      String
  email     String
  message   String
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model DailyPuzzle {
  id            String          @id
  question      String
  context       String?
  optionA       String
  optionB       String
  optionC       String
  optionD       String?
  correctAnswer String
  explanation   String
  category      String
  difficulty    String          @default("Medium")
  publishDate   DateTime
  createdAt     DateTime        @default(now())
  PuzzleAttempt PuzzleAttempt[]
}

model ExpertProfile {
  id              String    @id
  userId          String    @unique
  company         String
  role            String
  experienceYears Int
  linkedInUrl     String?
  isVerified      Boolean   @default(false)
  hourlyRateINR   Int
  skills          String
  User            User      @relation(fields: [userId], references: [id])
  Service         Service[]
}

model MentorshipBooking {
  id                 String              @id
  userId             String?
  name               String
  email              String
  phone              String
  serviceType        String
  paymentProof       String
  amount             Int
  status             String              @default("pending")
  adminNotes         String?
  scheduledAt        DateTime?
  meetingLink        String?
  completedAt        DateTime?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  MentorshipFeedback MentorshipFeedback?
}

model MentorshipFeedback {
  id                String            @id
  bookingId         String            @unique
  name              String
  email             String
  rating            Int
  feedback          String
  wouldRecommend    Boolean           @default(true)
  createdAt         DateTime          @default(now())
  MentorshipBooking MentorshipBooking @relation(fields: [bookingId], references: [id])
}

model PracticeFeedback {
  id           String   @id
  userId       String
  submissionId String?
  experience   String
  comments     String?
  npsScore     Int
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id])
}

model PracticeQuestion {
  id                 String               @id
  title              String
  description        String
  category           String
  difficulty         String
  solutionText       String?
  sampleAnswer       String?
  createdAt          DateTime             @default(now())
  PracticeSubmission PracticeSubmission[]
}

model PracticeSubmission {
  id               String           @id
  userId           String
  questionId       String
  answerText       String
  aiScore          String?
  timeSpent        Int?
  isGoldStandard   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  PracticeQuestion PracticeQuestion @relation(fields: [questionId], references: [id])
  User             User             @relation(fields: [userId], references: [id])
  Review           Review[]
}

model PuzzleAttempt {
  id          String      @id
  userId      String
  puzzleId    String
  answer      String
  isCorrect   Boolean
  timeTaken   Int?
  createdAt   DateTime    @default(now())
  DailyPuzzle DailyPuzzle @relation(fields: [puzzleId], references: [id])
  User        User        @relation(fields: [userId], references: [id])
}

model Review {
  id                 String             @id
  submissionId       String
  reviewerId         String?
  type               String
  content            String
  score              Int
  details            String?
  createdAt          DateTime           @default(now())
  aiAccuracy         Int?
  User               User?              @relation(fields: [reviewerId], references: [id])
  PracticeSubmission PracticeSubmission @relation(fields: [submissionId], references: [id])
}

model Service {
  id            String        @id
  expertId      String
  type          String
  title         String
  durationMin   Int
  priceINR      Int
  ExpertProfile ExpertProfile @relation(fields: [expertId], references: [id])
}

model Subscription {
  id                     String    @id
  userId                 String    @unique
  status                 String    @default("inactive")
  planType               String    @default("monthly")
  priceINR               Int       @default(199)
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String?
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime
  User                   User      @relation(fields: [userId], references: [id])
}

model SubscriptionRequest {
  id           String    @id
  userId       String
  name         String
  email        String
  phone        String
  paymentProof String
  amount       Int       @default(199)
  status       String    @default("pending")
  adminNotes   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model User {
  id                             String               @id
  email                          String               @unique
  authId                         String?              @unique
  name                           String?
  image                          String?
  role                           String               @default("STUDENT")
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime
  firstName                      String?
  lastName                       String?
  Booking_Booking_menteeIdToUser Booking[]            @relation("Booking_menteeIdToUser")
  Booking_Booking_mentorIdToUser Booking[]            @relation("Booking_mentorIdToUser")
  CategoryAttempt                CategoryAttempt[]
  ExpertProfile                  ExpertProfile?
  PracticeFeedback               PracticeFeedback[]
  PracticeSubmission             PracticeSubmission[]
  PuzzleAttempt                  PuzzleAttempt[]
  Review                         Review[]
  Subscription                   Subscription?
  UserActivity                   UserActivity[]
  UserStreak                     UserStreak?
}

model UserActivity {
  id        String   @id
  userId    String?
  page      String
  action    String
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
}

model UserStreak {
  id            String    @id
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastPlayedAt  DateTime?
  totalCorrect  Int       @default(0)
  totalPlayed   Int       @default(0)
  User          User      @relation(fields: [userId], references: [id])
}
